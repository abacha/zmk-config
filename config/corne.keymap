#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "NORMAL";
            bindings = <
&kp ESC        &kp Q  &kp W  &kp E     &kp R          &kp T        &kp Y        &kp U          &kp I      &kp O    &kp P     &kp BSPC
&mt LSHFT TAB  &kp A  &kp S  &kp D     &lt 2 F        &kp G        &kp H        &kp J          &kp K      &kp L    &kp SEMI  &mt RSHFT SQT
&kp LALT       &kp Z  &kp X  &kp C     &kp V          &kp B        &kp N        &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                             &kp LWIN  &mt LCTRL TAB  &lt 1 RET    &lt 2 SPACE  &mt RCTRL DEL  &kp RWIN
            >;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&studio_unlock  &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3    &trans  &kp HOME  &kp UP    &kp END    &kp LS(LBKT)  &trans
&sys_reset      &kp LCTRL        &kp LSHFT        &kp LALT         &kp LGUI         &trans          &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(RBKT)  &trans
&trans          &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans          &trans  &kp LPAR  &kp RPAR  &kp LBKT   &kp RBKT      &trans
                                                  &trans           &trans           &trans          &trans  &trans    &trans
            >;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp LA(NUMBER_1)  &kp GRAVE  &kp PRCNT  &kp PIPE       &kp AMPS       &kp EQUAL      &trans   &kp N7  &kp N8  &kp N9  &kp F1  &kp F2
&kp LA(N2)        &kp EXCL   &kp AT     &kp HASH       &kp DLLR       &kp LS(DOT)    &trans   &kp N4  &kp N5  &kp N6  &kp F3  &kp F4
&kp LA(NUMBER_3)  &kp CARET  &kp ASTRK  &kp LS(MINUS)  &kp LS(EQUAL)  &kp MINUS      &trans   &kp N1  &kp N2  &kp N3  &kp F5  &kp F6
                                        &trans         &trans         &trans         &kp RET  &kp N0  &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
