#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "NORMAL";
            bindings = <
&kp ESC        &kp Q  &kp W  &kp E     &kp R             &kp T        &kp Y        &kp U          &kp I      &kp O    &kp P     &kp BSPC
&mt LSHFT TAB  &kp A  &kp S  &kp D     &lt 2 F           &kp G        &kp H        &kp J          &kp K      &kp L    &kp SEMI  &mt RSHFT SQT
&kp LCTRL      &kp Z  &kp X  &kp C     &kp V             &kp B        &kp N        &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                             &kp LWIN  &mt LEFT_ALT TAB  &lt 1 RET    &lt 2 SPACE  &mt RCTRL DEL  &kp RWIN
            >;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp F21     &kp F21          &bt BT_SEL 0     &bt BT_SEL 1     &kp C_MUTE       &kp C_PLAY_PAUSE    &kp F21  &kp HOME  &kp UP    &kp END    &kp LS(LBKT)  &kp PRINTSCREEN
&sys_reset  &kp LCTRL        &kp LSHFT        &kp LALT         &kp C_PREVIOUS   &kp C_NEXT          &kp F21  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(RBKT)  &kp PAUSE_BREAK
&kp LCTRL   &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &kp F19             &kp F21  &kp LPAR  &kp RPAR  &kp LBKT   &kp RBKT      &kp SCROLLLOCK
                                              &kp LEFT_WIN     &kp LEFT_ALT     &kp F20             &kp F21  &kp F21   &kp F21
            >;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp LA(NUMBER_1)  &kp GRAVE  &kp PRCNT  &kp PIPE          &kp AMPS          &kp EQUAL        &kp NUMBER_7  &kp N8  &kp N9        &kp F1  &kp F2  &kp F3
&kp LA(N2)        &kp EXCL   &kp AT     &kp HASH          &kp DLLR          &kp LS(DOT)      &kp N4        &kp N5  &kp NUMBER_6  &kp F4  &kp F5  &kp F6
&kp LA(NUMBER_3)  &kp CARET  &kp ASTRK  &kp LS(MINUS)     &kp LS(EQUAL)     &kp MINUS        &kp N1        &kp N2  &kp N3        &kp F7  &kp F8  &kp F9
                                        &mt LEFT_WIN F10  &mt LEFT_ALT F11  &mt LCTRL F12    &kp F20       &kp N0  &kp F12
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
